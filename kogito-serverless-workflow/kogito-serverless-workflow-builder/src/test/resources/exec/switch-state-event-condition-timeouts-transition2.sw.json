{
  "id": "switch_state_event_condition_timeouts_transition2",
  "name": "Switch State Event Condition Timeouts Transition2 Test",
  "expressionLang": "jsonpath",
  "version": "1.0",
  "start": "ChooseOnEvent",
  "events": [
    {
      "name": "visaApprovedEvent",
      "source": "",
      "type": "visa_approved_in"
    },
    {
      "name": "visaDeniedEvent",
      "source": "",
      "type": "visa_denied_in"
    }
  ],
  "states": [
    {
      "name": "ChooseOnEvent",
      "type": "switch",
      "eventConditions": [
        {
          "eventRef": "visaApprovedEvent",
          "transition": "ApprovedVisa"
        },
        {
          "eventRef": "visaDeniedEvent",
          "transition": "DeniedVisa"
        }
      ],
      "defaultCondition": {
        "transition": "DeniedVisa"
      },
      "timeouts": {
        "eventTimeout": "PT2M"
      }
    },
    {
      "name": "ApprovedVisa",
      "type": "inject",
      "data": {
        "decision": "Approved"
      },
      "end": true
    },
    {
      "name": "DeniedVisa",
      "type": "inject",
      "data": {
        "decision": "Denied"
      },
      "end": true
    }
  ]
}